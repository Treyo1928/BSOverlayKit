# The bot's token (Discord Developer Portal -> your application -> Bot -> Reset Token). Keep it secret.
DISCORD_TOKEN=
# Optional, and wise when the bot is in more than one server: the one server it looks at (Developer Mode on,
# right-click the server -> Copy Server ID). It then sees, joins and changes nothing anywhere else.
GUILD_ID=
# Optional. The casting voice channel is picked in the overlay panel (Casters). This is only where the bot starts
# before anyone has picked: Developer Mode on, right-click the channel -> Copy Channel ID.
CASTER_CHANNEL_ID=
# Optional. People who are never casters whatever channel they sit in (comma separated user IDs). One-off cases are
# easier in the panel: untick the person there.
IGNORE_USER_IDS=
# (The players' voice channel, where players are deafened while they play, is picked in the panel only.)
# Optional. off: the bot passes no sound to the overlay, only who is in the channel and who is talking.
VOICE_AUDIO=on
# Where the overlay runs and its panel login code. Under docker compose both are filled in for you.
OVERLAY_URL=http://127.0.0.1:8095
OVERLAY_CODE=
