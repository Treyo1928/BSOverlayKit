# Copy to .env beside docker-compose.yml.

# The panel's login code: one shared secret for everyone who runs the stream. Make it long.
HOST_CODE=change-me-to-a-long-passphrase

# What it shows. "bscompstats" follows a tournament on the site; "sim" is the built-in simulator (for a look around).
KIT_SOURCE=bscompstats
# The site, the tournament's slug (the part after /t/), and an API key from the site (API keys page; read-only is enough).
BSCS_URL=https://bs.treyo.dev
BSCS_TOURNAMENT=
BSCS_KEY=

# The replay viewer (our ChroViewer build) as the BROWSER showing the overlay reaches it. With {n} every video box
# gets an address of its own (v1 … v5), which lets a browser run each replay in its own process: see DEPLOY.md.
CHROVIEWER_URL=https://v{n}.viewer.treyo.dev
# The same viewer's first address, baked into the viewer when it is built (its BeatLeader pass-through).
VIEWER_PUBLIC_URL=https://v1.viewer.treyo.dev
# Where the ChroViewer source is (branch msu), for building its image.
CHROVIEWER_DIR=../chroviewer
# TournamentAssistant servers whose live replays the viewer may relay, besides TA's public one: host:port, comma separated.
TA_LIVE_HOSTS=

# With the bundled Caddy (docker compose --profile tls up -d): the two names it serves.
OVERLAY_ADDRESS=overlay.treyo.dev
VIEWER_ADDRESSES=v1.viewer.treyo.dev, v2.viewer.treyo.dev, v3.viewer.treyo.dev, v4.viewer.treyo.dev, v5.viewer.treyo.dev
